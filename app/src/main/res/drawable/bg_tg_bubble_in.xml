<?xml version="1.0" encoding="utf-8"?>
<!-- Burbuja de mensaje de Telegram; con el foco del mando, borde naranja -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:topLeftRadius="16dp" android:topRightRadius="16dp" android:bottomLeftRadius="4dp" android:bottomRightRadius="16dp" />
            <solid android:color="@color/tg_bubble_in" />
            <stroke android:width="2dp" android:color="@color/primary" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:topLeftRadius="16dp" android:topRightRadius="16dp" android:bottomLeftRadius="4dp" android:bottomRightRadius="16dp" />
            <solid android:color="@color/tg_bubble_in" />
            <stroke android:width="1dp" android:color="@color/list_slot_border" />
        </shape>
    </item>
</selector>
