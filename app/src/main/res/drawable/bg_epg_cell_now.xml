<?xml version="1.0" encoding="utf-8"?>
<!-- Celda del programa que está en emisión AHORA MISMO: igual que
     bg_epg_cell pero resaltada con el color de acento, para que destaque de
     un vistazo en qué punto de cada fila está "ahora" (equivalente, en la
     parrilla, a la línea "Ahora" en negrita de la lista de canales). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#33FF6B4A" />
    <stroke
        android:width="1dp"
        android:color="@color/primary" />
</shape>
