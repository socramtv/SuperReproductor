<?xml version="1.0" encoding="utf-8"?>
<menu xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- Insignia premium: solo visible con un código de acceso desbloqueado (ver MainActivity.onPrepareOptionsMenu). -->
    <item
        android:id="@+id/action_premium"
        android:title="@string/premium_tag"
        android:visible="false"
        app:showAsAction="never" />

    <item
        android:id="@+id/action_search"
        android:title="@string/action_search"
        android:icon="@android:drawable/ic_menu_search"
        app:showAsAction="collapseActionView|always"
        app:actionViewClass="androidx.appcompat.widget.SearchView" />

    <!-- Búsqueda global por voz (ver MainActivity.startVoiceSearch) -->
    <item
        android:id="@+id/action_voice"
        android:title="@string/action_voice"
        android:icon="@android:drawable/ic_btn_speak_now"
        app:iconTint="@color/on_background"
        app:showAsAction="always" />

    <item
        android:id="@+id/action_epg_grid"
        android:title="@string/action_epg_grid"
        android:icon="@android:drawable/ic_menu_agenda"
        app:showAsAction="always" />

    <!-- Icono/título reales los pone MainActivity.updateThemeMenuItem según
         el modo actual (sol/luna); esto es solo el valor inicial.
         app:iconTint="@color/on_background": ic_sun.xml/ic_moon.xml llevan
         su relleno en blanco fijo, que se perdería contra la barra blanca
         del modo claro; el tintado de icono de menú se vuelve a aplicar
         solo con cada icono que ponga updateThemeMenuItem (comportamiento
         de AppCompat), así que basta con ponerlo aquí una vez. -->
    <item
        android:id="@+id/action_theme_toggle"
        android:title="@string/action_switch_to_light"
        android:icon="@drawable/ic_sun"
        app:iconTint="@color/on_background"
        app:showAsAction="always" />


    <!-- Menú de los tres puntos, agrupado por apartados -->
