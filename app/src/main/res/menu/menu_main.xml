<?xml version="1.0" encoding="utf-8"?>
<menu xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <item
        android:id="@+id/action_search"
        android:title="@string/action_search"
        android:icon="@android:drawable/ic_menu_search"
        app:showAsAction="collapseActionView|always"
        app:actionViewClass="androidx.appcompat.widget.SearchView" />

    <!-- Búsqueda global por voz (ver MainActivity.startVoiceSearch) -->
    <item
        android:id="@+id/action_voice"
        android:title="@string/action_voice"
        android:icon="@android:drawable/ic_btn_speak_now"
        app:iconTint="@color/on_background"
        app:showAsAction="always" />

    <item
        android:id="@+id/action_epg_grid"
        android:title="@string/action_epg_grid"
        android:icon="@android:drawable/ic_menu_agenda"
        app:showAsAction="always" />

    <!-- Icono/título reales los pone MainActivity.updateThemeMenuItem según
         el modo actual (sol/luna); esto es solo el valor inicial.
         app:iconTint="@color/on_background": ic_sun.xml/ic_moon.xml llevan
         su relleno en blanco fijo, que se perdería contra la barra blanca
         del modo claro; el tintado de icono de menú se vuelve a aplicar
         solo con cada icono que ponga updateThemeMenuItem (comportamiento
         de AppCompat), así que basta con ponerlo aquí una vez. -->
    <item
        android:id="@+id/action_theme_toggle"
        android:title="@string/action_switch_to_light"
        android:icon="@drawable/ic_sun"
        app:iconTint="@color/on_background"
        app:showAsAction="always" />


    <!-- Copia de seguridad (ver BackupManager): en el menú de los tres
         puntos para no recargar la barra. -->
    <!-- Mosaico de favoritos con lo que emiten ahora (ver NowLiveActivity) -->
    <item
        android:id="@+id/action_now_live"
        android:title="@string/action_now_live"
        app:showAsAction="never" />

    <!-- Perfiles (ver data/Profiles); el título lleva el perfil activo (lo pone MainActivity) -->
    <item
        android:id="@+id/action_profiles"
        android:title="@string/action_profiles"
        app:showAsAction="never" />

    <!-- Avisos cuando la guía trae un programa o serie (ver reminder/ProgramAlerts) -->
    <item
        android:id="@+id/action_program_alerts"
        android:title="@string/action_program_alerts"
        app:showAsAction="never" />

    <!-- Pausa en directo: cuántos minutos se guardan (ver player/TimeShiftSession) -->
    <item
        android:id="@+id/action_timeshift"
        android:title="@string/timeshift_menu_item"
        app:showAsAction="never" />

    <!-- Avisos de goles y eventos de tus equipos (ver sports/GoalAlerts) -->
    <item
        android:id="@+id/action_goal_alerts"
        android:title="@string/action_goal_alerts"
        app:showAsAction="never" />

    <item
        android:id="@+id/action_backup_export"
        android:title="@string/action_backup_export"
        app:showAsAction="never" />

    <item
        android:id="@+id/action_backup_import"
        android:title="@string/action_backup_import"
        app:showAsAction="never" />

</menu>
