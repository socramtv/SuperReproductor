<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_dark">

    <FrameLayout
        android:id="@+id/headerFrame"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface_dark">

        <!-- Logo de cabecera a todo el ancho real de la barra (ver README,
             sección "Logo de cabecera"): sin recortar ni deformar
             (adjustViewBounds mantiene su proporción real: el alto final
             sale solo de esa proporción, no hay que fijarlo a mano). -->
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:src="@drawable/header_logo"
            android:contentDescription="@string/app_name" />

        <!-- El Toolbar de siempre (buscador, parrilla EPG, claro/oscuro),
             ahora sin fondo propio y superpuesto encima del logo en vez de
             ir al lado: por eso usa sus propios iconos en blanco fijo
             (@color/player_text, ver colors.xml) en vez del color normal de
             icono, que cambia con el modo claro/oscuro -el logo tiene fondo
             oscuro siempre, así que un icono oscuro en modo claro se
             perdería encima-. El ThemeOverlay es un segundo seguro para
             cualquier icono que no se tiña a mano explícitamente (p. ej. el
             de "más opciones" si algún día no caben los tres). -->
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/transparent"
            android:theme="@style/ThemeOverlay.MaterialComponents.Dark.ActionBar" />

    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingTop="10dp"
        android:paddingBottom="2dp">

        <android.widget.Button
            android:id="@+id/listButton1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingVertical="10dp"
            android:text="@string/list_slot_1"
            android:textAllCaps="false"
            android:textSize="13sp"
            android:textColor="@color/on_background"
            android:background="@drawable/bg_list_slot_button" />

        <android.widget.Button
            android:id="@+id/listButton2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginHorizontal="4dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingVertical="10dp"
            android:text="@string/list_slot_2"
            android:textAllCaps="false"
            android:textSize="13sp"
            android:textColor="@color/on_background"
            android:background="@drawable/bg_list_slot_button" />

        <android.widget.Button
            android:id="@+id/listButton3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingVertical="10dp"
            android:text="@string/list_slot_3"
            android:textAllCaps="false"
            android:textSize="13sp"
            android:textColor="@color/on_background"
            android:background="@drawable/bg_list_slot_button" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingTop="6dp"
        android:paddingBottom="2dp">

        <android.widget.Button
            android:id="@+id/listButton4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingVertical="10dp"
            android:text="@string/list_slot_4"
            android:textAllCaps="false"
            android:textSize="13sp"
            android:textColor="@color/on_background"
            android:background="@drawable/bg_list_slot_button" />

        <android.widget.Button
            android:id="@+id/listButton5"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginHorizontal="4dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingVertical="10dp"
            android:text="@string/list_slot_5"
            android:textAllCaps="false"
            android:textSize="13sp"
            android:textColor="@color/on_background"
            android:background="@drawable/bg_list_slot_button" />

        <!-- Mismo formato que las dos anteriores, pero fija (no es un hueco de
             URL remota): hace lo mismo que el icono de carpeta de la barra
             superior, elegir un archivo JSON/M3U del propio dispositivo. -->
        <android.widget.Button
            android:id="@+id/loadFileButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingVertical="10dp"
            android:text="@string/action_load_file_button"
            android:textAllCaps="false"
            android:textSize="13sp"
            android:textColor="@color/on_background"
            android:background="@drawable/bg_list_slot_button" />

    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingVertical="8dp" />

        <TextView
            android:id="@+id/emptyView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:padding="32dp"
            android:gravity="center"
            android:text="@string/empty_categories"
            android:textColor="@color/on_surface_muted"
            android:visibility="gone" />

    </FrameLayout>

</LinearLayout>
