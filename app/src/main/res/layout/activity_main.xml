<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_dark">

    <!-- Logo de cabecera a todo el ancho real (ver README, sección "Logo de
         cabecera"): sin recortar ni deformar (adjustViewBounds mantiene su
         proporción real: el alto final sale solo de esa proporción, no hay
         que fijarlo a mano). Sin ningún icono encima: con lo variada/clara
         que es la foto de fondo (césped, camisetas blancas, escudos...) no
         hay un solo color de icono que se viera bien en todas las zonas, así
         que los iconos van en su propia barra sólida justo debajo, con
         contraste garantizado siempre en vez de depender de qué haya debajo.
         android:maxHeight (solo entra en juego si hiciera falta, ver
         dimens.xml): en TV, drawable-television/header_logo.jpg ya es una
         imagen más apaisada pensada para no ocupar tanto alto en una
         pantalla mucho más ancha que alta; el tope es un segundo seguro por
         si alguna TV en concreto aun así necesitara más alto del que debe. -->
    <ImageView
        android:id="@+id/headerLogo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface_dark"
        android:adjustViewBounds="true"
        android:maxHeight="@dimen/header_logo_max_height"
        android:scaleType="fitCenter"
        android:src="@drawable/header_logo"
        android:contentDescription="@string/app_name" />

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="?attr/actionBarSize"
        android:background="@color/surface_dark" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingTop="10dp"
        android:paddingBottom="2dp">

        <android.widget.Button
            android:id="@+id/listButton1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingVertical="10dp"
            android:text="@string/list_slot_1"
            android:textAllCaps="false"
            android:textSize="13sp"
            android:textColor="@color/on_background"
            android:background="@drawable/bg_list_slot_button" />

        <android.widget.Button
            android:id="@+id/listButton2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginHorizontal="4dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingVertical="10dp"
            android:text="@string/list_slot_2"
            android:textAllCaps="false"
            android:textSize="13sp"
            android:textColor="@color/on_background"
            android:background="@drawable/bg_list_slot_button" />

        <android.widget.Button
            android:id="@+id/listButton3"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingVertical="10dp"
            android:text="@string/list_slot_3"
            android:textAllCaps="false"
            android:textSize="13sp"
            android:textColor="@color/on_background"
            android:background="@drawable/bg_list_slot_button" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingTop="6dp"
        android:paddingBottom="2dp">

        <android.widget.Button
            android:id="@+id/listButton4"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingVertical="10dp"
            android:text="@string/list_slot_4"
            android:textAllCaps="false"
            android:textSize="13sp"
            android:textColor="@color/on_background"
            android:background="@drawable/bg_list_slot_button" />

        <android.widget.Button
            android:id="@+id/listButton5"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginHorizontal="4dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingVertical="10dp"
            android:text="@string/list_slot_5"
            android:textAllCaps="false"
            android:textSize="13sp"
            android:textColor="@color/on_background"
            android:background="@drawable/bg_list_slot_button" />

        <!-- Mismo formato que las dos anteriores, pero fija (no es un hueco de
             URL remota): hace lo mismo que el icono de carpeta de la barra
             superior, elegir un archivo JSON/M3U del propio dispositivo. -->
        <android.widget.Button
            android:id="@+id/loadFileButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingVertical="10dp"
            android:text="@string/action_load_file_button"
            android:textAllCaps="false"
            android:textSize="13sp"
            android:textColor="@color/on_background"
            android:background="@drawable/bg_list_slot_button" />

    </LinearLayout>

    <!-- Opciones de la lista cargada (ver MainActivity.
         updateCategoryFilterButton): a la izquierda un texto de estado
         (categorías que se ven y cuándo se actualizó) y a la derecha un
         único botón de engranaje que abre el menú con Categorías, Ordenar y
         Actualizar (esta última solo en las 5 listas remotas). Si la lista no
         tiene nada que ofrecer, toda la fila se oculta. -->
    <LinearLayout
        android:id="@+id/categoryButtonsRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="12dp"
        android:paddingTop="6dp"
        android:paddingBottom="2dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/categoryStatusText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/on_surface_muted"
            android:textSize="12sp"
            android:maxLines="2"
            android:ellipsize="end" />

        <ImageButton
            android:id="@+id/categoryOptionsButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="10dp"
            android:background="@drawable/bg_list_options_button"
            android:src="@drawable/ic_settings"
            android:tint="@color/on_background"
            android:contentDescription="@string/list_options_button" />

    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingVertical="8dp" />

        <TextView
            android:id="@+id/emptyView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:padding="32dp"
            android:gravity="center"
            android:text="@string/empty_categories"
            android:textColor="@color/on_surface_muted"
            android:visibility="gone" />

    </FrameLayout>

</LinearLayout>
