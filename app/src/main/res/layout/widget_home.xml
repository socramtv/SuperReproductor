<?xml version="1.0" encoding="utf-8"?>
<!--
    Widget "Socram TV+" completo: cabecera con el título (abre la app), tres
    pestañas (Favoritos / Continuar / Partidos) y refrescar; debajo, la lista
    que se desplaza (ver HomeWidgetService). Solo vistas de RemoteViews.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetHomeRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="8dp"
    android:background="@drawable/bg_widget">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/widgetHomeTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="4dp"
            android:text="@string/app_widget_title"
            android:textColor="#FF6B4A"
            android:textSize="13sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/widgetTabFav"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:text="@string/widget_tab_favorites"
            android:textColor="#B0B0BC"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/widgetTabContinue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:text="@string/widget_tab_continue"
            android:textColor="#B0B0BC"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/widgetTabMatches"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:text="@string/widget_tab_matches"
            android:textColor="#B0B0BC"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/widgetRefresh"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:text="⟳"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />

    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/widgetList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@null"
            android:dividerHeight="0dp" />

        <TextView
            android:id="@+id/widgetListEmpty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:padding="12dp"
            android:textColor="#B0B0BC"
            android:textSize="12sp" />

    </FrameLayout>

</LinearLayout>
