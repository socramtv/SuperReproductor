<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <!--
        show_previous/next/rewind/fastforward_button="false": por defecto
        Media3 muestra ahí, centrados en medio de la pantalla, los botones
        de "anterior/siguiente" (de pista, sin sentido aquí: nunca hay más
        de un MediaItem cargado a la vez) y "retroceder/avanzar 10s". Esos
        dos últimos quedaban justo encima de las zonas de toque izquierda/
        derecha para cambiar de canal (ver playerTapGestureDetector en
        PlayerActivity) y se comían el toque antes de que le llegara a esa
        zona: por eso tocar el lateral avanzaba/retrocedía el vídeo unos
        segundos en vez de cambiar de canal. Al quitarlos, en el centro solo
        queda el botón de play/pausa, bien dentro del tercio central.
    -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:show_buffering="when_playing"
        app:show_previous_button="false"
        app:show_next_button="false"
        app:show_rewind_button="false"
        app:show_fastforward_button="false" />

    <!--
        Overlay de "radio": PlayerActivity la muestra solo cuando el stream
        actual no tiene pista de vídeo (se detecta sola a partir de las
        pistas reales, no hace falta declarar nada en el JSON/M3U). Muestra
        el logo del canal y lo que se está escuchando ahora mismo (el
        título dinámico ICY/ID3 si el stream lo trae, si no el nombre fijo
        del canal).
    -->
    <LinearLayout
        android:id="@+id/nowPlayingOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@android:color/black"
        android:padding="32dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/nowPlayingLogo"
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:scaleType="fitCenter"
            android:contentDescription="@null"
            android:src="@drawable/ic_radio" />

        <TextView
            android:id="@+id/nowPlayingTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:maxLines="2"
            android:ellipsize="end"
            android:textColor="@color/player_text"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/nowPlayingSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/player_text_muted"
            android:textSize="14sp" />

    </LinearLayout>

    <!--
        Chromecast (ver PlayerActivity.isCastButtonUsable/onCastSessionChanged),
        solo, arriba a la derecha (con margen de sobra para que no quede escondido en la franja negra del borde). MediaRouteButton es una vista especial del
        propio framework de mediarouter/Cast -su icono cambia solo según
        busca/conecta/está conectada-, por eso no es un ImageButton normal,
        pero acepta el mismo fondo circular y tinte blanco. Empieza oculto
        (ver PlayerActivity.onCreate) y CastButtonFactory lo muestra solo en
        cuanto aparece algún Chromecast en la red; si el dispositivo no tiene
        Google Play Services, se queda oculto del todo.
    -->
    <androidx.mediarouter.app.MediaRouteButton
        android:id="@+id/castButton"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="88dp"
        android:padding="10dp"
        android:background="@drawable/bg_round_button"
        android:visibility="gone"
        app:mediaRouteButtonTint="@android:color/white"
        android:contentDescription="@string/action_cast" />

    <!--
        Fila de acciones del reproductor: vídeo+audio (un solo botón),
        subtítulos, formato de pantalla e imagen en imagen. En
        PlayerActivity.onCreate se MUEVEN a la fila de abajo de los controles
        de Media3 (la de la hora y el engranaje, justo debajo de la barra de
        progreso), para que queden alineadas con ella y aparezcan y
        desaparezcan con los controles. Este contenedor solo es el plan B si
        esa fila no se encuentra: se queda abajo a la derecha.
    -->
    <LinearLayout
        android:id="@+id/playerActionsFallback"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="72dp"
        android:layout_marginBottom="4dp"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/trackSelectionButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="12dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_tune"
            android:tint="@android:color/white"
            android:contentDescription="@string/action_track_selection" />

        <ImageButton
            android:id="@+id/subtitlesButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="12dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_subtitles"
            android:tint="@android:color/white"
            android:contentDescription="@string/action_subtitles" />

        <ImageButton
            android:id="@+id/videoFormatButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="12dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_aspect_ratio"
            android:tint="@android:color/white"
            android:contentDescription="@string/action_video_format" />

        <ImageButton
            android:id="@+id/guideButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="12dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_guide"
            android:tint="@android:color/white"
            android:contentDescription="@string/action_guide" />

        <ImageButton
            android:id="@+id/multiViewButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="12dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_multiview"
            android:tint="@android:color/white"
            android:contentDescription="@string/action_multiview" />

        <ImageButton
            android:id="@+id/sleepTimerButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="12dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_timer"
            android:tint="@android:color/white"
            android:contentDescription="@string/action_sleep_timer" />

        <ImageButton
            android:id="@+id/pipButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="12dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_picture_in_picture"
            android:tint="@android:color/white"
            android:contentDescription="@string/action_pip" />

    </LinearLayout>

    <!--
        Mini marcador flotante (ver PlayerActivity.refreshFloatingScore): los
        partidos en juego de los equipos que sigues, arriba a la izquierda.
    -->
    <TextView
        android:id="@+id/floatingScore"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:maxWidth="300dp"
        android:background="@drawable/bg_floating_score"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp"
        android:textColor="@color/player_text"
        android:textSize="13sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!--
        Pausa en directo (ver TimeShiftSession / PlayerActivity): cuánto va
        por detrás del directo y botones para retroceder, adelantar y volver
        al directo. Solo se ve con los controles y si el canal usa el buffer.
    -->
    <LinearLayout
        android:id="@+id/timeShiftBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginBottom="128dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#99000000"
        android:paddingHorizontal="16dp"
        android:paddingVertical="6dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/timeShiftStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/player_text"
            android:textSize="14sp"
            android:textStyle="bold"
            android:maxLines="1" />

        <TextView
            android:id="@+id/tsBack5"
            style="@style/TimeShiftButton"
            android:text="@string/timeshift_back_5m" />

        <TextView
            android:id="@+id/tsBack30"
            style="@style/TimeShiftButton"
            android:text="@string/timeshift_back_30s" />

        <TextView
            android:id="@+id/tsFwd30"
            style="@style/TimeShiftButton"
            android:text="@string/timeshift_fwd_30s" />

        <TextView
            android:id="@+id/tsLive"
            style="@style/TimeShiftButton"
            android:text="@string/timeshift_go_live" />

    </LinearLayout>

    <!--
        "Qué se está viendo" para canales de VÍDEO (la radio ya tiene su
        propio overlay permanente arriba, este no se usa en ese caso): un
        toque en la pantalla saca los controles normales de reproducción
        (eso ya lo hace PlayerView solo) y, a la vez, este cartel abajo con
        el canal y -si hay- el programa que marca la guía o el título
        dinámico ICY/ID3; se oculta solo junto con los controles. Mismo
        texto que calcula refreshNowPlayingDisplay() para el overlay de
        radio, solo que aplicado también aquí.
    -->
    <LinearLayout
        android:id="@+id/videoNowPlayingBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginBottom="72dp"
        android:orientation="vertical"
        android:background="#99000000"
        android:paddingHorizontal="20dp"
        android:paddingVertical="10dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/videoNowPlayingTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/player_text"
            android:textSize="16sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/videoNowPlayingSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/player_text_muted"
            android:textSize="13sp"
            android:maxLines="1"
            android:ellipsize="end" />

    </LinearLayout>

    <!--
        Indicador de brillo (ver handleBrightnessDrag/showBrightnessIndicator
        en PlayerActivity): a diferencia del de volumen, que reutiliza el
        propio del sistema, este es propio porque no hay ningún indicador de
        sistema para un brillo de ventana a medida. Aparece al arrastrar por
        la mitad izquierda de la pantalla y se oculta solo un rato después
        del último cambio.
    -->
    <TextView
        android:id="@+id/brightnessIndicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="#99000000"
        android:paddingHorizontal="20dp"
        android:paddingVertical="10dp"
        android:textColor="@color/player_text"
        android:textSize="16sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!--
        Mini-guía: panel a la derecha con los canales de la lista actual,
        su programa de ahora y el siguiente (ver PlayerActivity.showMiniGuide).
        Se abre con el botón de guía de la fila de abajo (o la tecla GUÍA del
        mando); elegir un canal cambia a él sin salir del reproductor.
    -->
    <LinearLayout
        android:id="@+id/miniGuidePanel"
        android:layout_width="340dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:orientation="vertical"
        android:background="#EE000000"
        android:clickable="true"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp"
            android:text="@string/guide_title"
            android:textColor="@color/player_text"
            android:textSize="16sp"
            android:textStyle="bold" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/miniGuideList"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false" />

    </LinearLayout>

</FrameLayout>
