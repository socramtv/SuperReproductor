<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <!--
        show_previous/next/rewind/fastforward_button="false": por defecto
        Media3 muestra ahí, centrados en medio de la pantalla, los botones
        de "anterior/siguiente" (de pista, sin sentido aquí: nunca hay más
        de un MediaItem cargado a la vez) y "retroceder/avanzar 10s". Esos
        dos últimos quedaban justo encima de las zonas de toque izquierda/
        derecha para cambiar de canal (ver playerTapGestureDetector en
        PlayerActivity) y se comían el toque antes de que le llegara a esa
        zona: por eso tocar el lateral avanzaba/retrocedía el vídeo unos
        segundos en vez de cambiar de canal. Al quitarlos, en el centro solo
        queda el botón de play/pausa, bien dentro del tercio central.
    -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:show_buffering="when_playing"
        app:show_previous_button="false"
        app:show_next_button="false"
        app:show_rewind_button="false"
        app:show_fastforward_button="false" />

    <!--
        Overlay de "radio": PlayerActivity la muestra solo cuando el stream
        actual no tiene pista de vídeo (se detecta sola a partir de las
        pistas reales, no hace falta declarar nada en el JSON/M3U). Muestra
        el logo del canal y lo que se está escuchando ahora mismo (el
        título dinámico ICY/ID3 si el stream lo trae, si no el nombre fijo
        del canal).
    -->
    <LinearLayout
        android:id="@+id/nowPlayingOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@android:color/black"
        android:padding="32dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/nowPlayingLogo"
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:scaleType="fitCenter"
            android:contentDescription="@null"
            android:src="@drawable/ic_radio" />

        <TextView
            android:id="@+id/nowPlayingTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:maxLines="2"
            android:ellipsize="end"
            android:textColor="@color/on_background"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/nowPlayingSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/on_surface_muted"
            android:textSize="14sp" />

    </LinearLayout>

    <ImageButton
        android:id="@+id/trackSelectionButton"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:layout_gravity="top|start"
        android:layout_margin="16dp"
        android:padding="10dp"
        android:background="@drawable/bg_round_button"
        android:src="@drawable/ic_settings"
        android:tint="@android:color/white"
        android:contentDescription="@string/action_track_selection" />

    <!--
        Entra en modo imagen-en-imagen a petición (ver maybeEnterPictureInPicture
        en PlayerActivity). Además de este botón, salir de la app mientras un
        canal de vídeo está en reproducción (Inicio, cambiar de app) también
        entra en PiP solo, sin tener que tocar nada (ver onUserLeaveHint).
        Oculto para canales de radio (ya siguen sonando en segundo plano sin
        PiP) y se oculta junto al resto de controles.
    -->
    <ImageButton
        android:id="@+id/pipButton"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:layout_gravity="top|end"
        android:layout_margin="16dp"
        android:padding="10dp"
        android:background="@drawable/bg_round_button"
        android:src="@drawable/ic_picture_in_picture"
        android:tint="@android:color/white"
        android:contentDescription="@string/action_pip" />

    <!--
        "Qué se está viendo" para canales de VÍDEO (la radio ya tiene su
        propio overlay permanente arriba, este no se usa en ese caso): un
        toque en la pantalla saca los controles normales de reproducción
        (eso ya lo hace PlayerView solo) y, a la vez, este cartel abajo con
        el canal y -si hay- el programa que marca la guía o el título
        dinámico ICY/ID3; se oculta solo junto con los controles. Mismo
        texto que calcula refreshNowPlayingDisplay() para el overlay de
        radio, solo que aplicado también aquí.
    -->
    <LinearLayout
        android:id="@+id/videoNowPlayingBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginBottom="72dp"
        android:orientation="vertical"
        android:background="#99000000"
        android:paddingHorizontal="20dp"
        android:paddingVertical="10dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/videoNowPlayingTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/on_background"
            android:textSize="16sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/videoNowPlayingSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/on_surface_muted"
            android:textSize="13sp"
            android:maxLines="1"
            android:ellipsize="end" />

    </LinearLayout>

</FrameLayout>
