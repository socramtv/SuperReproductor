<?xml version="1.0" encoding="utf-8"?>
<!-- Multivista: dos canales a la vez (ver MultiViewActivity). El LinearLayout
     cambia de horizontal a vertical según la orientación de la pantalla. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <LinearLayout
        android:id="@+id/multiRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/paneA"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:focusable="true"
            android:clickable="true">

            <androidx.media3.ui.PlayerView
                android:id="@+id/playerA"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:use_controller="false"
                app:show_buffering="when_playing" />

            <TextView
                android:id="@+id/nameA"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:layout_margin="8dp"
                android:background="#99000000"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/player_text"
                android:textSize="13sp" />

            <ImageButton
                android:id="@+id/changeA"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="bottom|end"
                android:layout_margin="6dp"
                android:padding="10dp"
                android:background="@drawable/bg_round_button"
                android:src="@drawable/ic_swap_vert"
                android:tint="@android:color/white"
                android:contentDescription="@string/multiview_change" />

            <View
                android:id="@+id/frameA"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_multiview_active" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/paneB"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:focusable="true"
            android:clickable="true">

            <androidx.media3.ui.PlayerView
                android:id="@+id/playerB"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:use_controller="false"
                app:show_buffering="when_playing" />

            <TextView
                android:id="@+id/nameB"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:layout_margin="8dp"
                android:background="#99000000"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/player_text"
                android:textSize="13sp" />

            <ImageButton
                android:id="@+id/changeB"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="bottom|end"
                android:layout_margin="6dp"
                android:padding="10dp"
                android:background="@drawable/bg_round_button"
                android:src="@drawable/ic_swap_vert"
                android:tint="@android:color/white"
                android:contentDescription="@string/multiview_change" />

            <View
                android:id="@+id/frameB"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_multiview_idle" />
        </FrameLayout>
    </LinearLayout>

    <ImageButton
        android:id="@+id/closeMulti"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="8dp"
        android:padding="10dp"
        android:background="@drawable/bg_round_button"
        android:src="@android:drawable/ic_menu_close_clear_cancel"
        android:tint="@android:color/white"
        android:contentDescription="@string/multiview_close" />

    <TextView
        android:id="@+id/multiHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="60dp"
        android:background="#99000000"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp"
        android:text="@string/multiview_hint"
        android:textColor="@color/player_text"
        android:textSize="12sp" />

</FrameLayout>
