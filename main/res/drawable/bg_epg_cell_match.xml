<?xml version="1.0" encoding="utf-8"?>
<!-- Celda que coincide con la búsqueda en curso (ver EpgGridAdapter /
     EpgGridMath.matchesSearch): mismo estilo que bg_epg_cell_now pero en
     dorado (@color/favorite, el mismo color de las estrellas de favoritos),
     para distinguirla de un vistazo tanto de una celda normal como de la de
     "ahora". Si una celda es a la vez "ahora" Y coincide con la búsqueda,
     gana este estilo: lo que se está buscando importa más en ese momento
     que lo que toca ahora mismo, que ya se puede encontrar solo con el
     botón "Ahora" sin necesidad de buscador. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#33FFC857" />
    <stroke
        android:width="2dp"
        android:color="@color/favorite" />
</shape>
