<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.SuperReproductor" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_variant</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="android:windowBackground">@color/background_dark</item>
        <item name="colorSurface">@color/surface_dark</item>
        <item name="colorOnSurface">@color/on_background</item>
        <item name="android:statusBarColor">@color/background_dark</item>
        <item name="android:windowLightStatusBar">@bool/is_light_status_bar</item>
        <item name="colorControlHighlight">@color/primary</item>
    </style>

    <style name="Theme.SuperReproductor.Player" parent="Theme.SuperReproductor">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowBackground">@android:color/black</item>
    </style>


    <!-- Botones de la barra de pausa en directo del reproductor (ver activity_player.xml) -->
    <style name="TimeShiftButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">8dp</item>
        <item name="android:paddingHorizontal">12dp</item>
        <item name="android:paddingVertical">8dp</item>
        <item name="android:background">@drawable/bg_ts_button</item>
        <item name="android:textColor">@color/player_text</item>
        <item name="android:textSize">13sp</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
    </style>

</resources>
