<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Vista de parrilla de guía EPG (ver EpgGridActivity): ancho fijo de la
        columna de nombre de canal (siempre a la izquierda, no se desplaza
        con el scroll horizontal) y alto de cada fila/cabecera de horas.
        Tienen que coincidir exactamente entre activity_epg_grid.xml (la
        cabecera de horas) e item_epg_grid_row.xml (cada canal): si no, las
        horas de la cabecera no quedarían alineadas con los programas de
        debajo.
    -->
    <dimen name="epg_channel_column_width">108dp</dimen>
    <dimen name="epg_row_height">76dp</dimen>
    <dimen name="epg_header_height">28dp</dimen>

    <!-- Tope de alto del logo de cabecera de la portada (ver README, sección
         "Logo de cabecera"): en el móvil, de sobra alto como para que nunca
         llegue a aplicarse de verdad (es solo una red de seguridad); en TV
         (values-television/dimens.xml) se reduce de verdad, porque ahí la
         pantalla es mucho más ancha que alta y el logo a todo lo ancho
         ocupaba demasiada altura. -->
    <dimen name="header_logo_max_height">400dp</dimen>
</resources>
