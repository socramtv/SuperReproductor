<?xml version="1.0" encoding="utf-8"?>
<!-- Un mensaje del chat de Telegram como burbuja (entrantes a la izquierda, tuyos a la derecha) -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="8dp"
    android:paddingVertical="3dp">

    <LinearLayout
        android:id="@+id/tgbColumn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/tgbBubble"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="10dp"
            android:paddingTop="6dp"
            android:paddingBottom="4dp"
            android:focusable="true"
            android:clickable="true"
            android:background="@drawable/bg_tg_bubble_in">

            <TextView
                android:id="@+id/tgbSender"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/primary"
                android:textSize="13sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <FrameLayout
                android:id="@+id/tgbImageFrame"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/tgbImage"
                    android:layout_width="220dp"
                    android:layout_height="160dp"
                    android:scaleType="centerCrop"
                    android:background="@color/tg_chat_bg"
                    android:contentDescription="@null" />

                <TextView
                    android:id="@+id/tgbPlay"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:text="▶"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:background="#99000000"
                    android:visibility="gone" />
            </FrameLayout>

            <TextView
                android:id="@+id/tgbFile"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:maxWidth="260dp"
                android:textColor="@color/on_background"
                android:textSize="14sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tgbText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/on_background"
                android:textSize="15sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tgbTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="2dp"
                android:textColor="@color/on_surface_muted"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tgbButtons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="2dp"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
