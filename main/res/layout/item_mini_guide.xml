<?xml version="1.0" encoding="utf-8"?>
<!-- Una fila de la mini-guía del reproductor (ver MiniGuideAdapter) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingHorizontal="12dp"
    android:paddingVertical="8dp"
    android:clickable="true"
    android:focusable="true"
    android:background="@drawable/bg_mini_guide_row">

    <ImageView
        android:id="@+id/guideLogo"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:scaleType="centerInside"
        android:padding="3dp"
        android:background="#22FFFFFF"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="10dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/guideName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/player_text"
            android:textSize="13sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/guideNow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/player_text"
            android:textSize="12sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <ProgressBar
            android:id="@+id/guideProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginVertical="3dp"
            android:max="100"
            android:progressTint="@color/primary"
            android:progressBackgroundTint="#33FFFFFF" />

        <TextView
            android:id="@+id/guideNext"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/player_text_muted"
            android:textSize="11sp"
            android:maxLines="1"
            android:ellipsize="end" />

    </LinearLayout>

</LinearLayout>
