<?xml version="1.0" encoding="utf-8"?>
<!-- Telegram (ver TelegramAccountActivity): lista de chats y, al abrir uno, sus mensajes -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_dark">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="?attr/actionBarSize"
        android:background="@color/surface_dark"
        app:titleTextColor="@color/on_background" />

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tgTabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface_dark"
        android:visibility="gone"
        app:tabMode="scrollable"
        app:tabIndicatorColor="@color/primary"
        app:tabSelectedTextColor="@color/primary"
        app:tabTextColor="@color/on_background" />

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tgSearchTabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface_dark"
        android:visibility="gone"
        app:tabIndicatorColor="@color/primary"
        app:tabSelectedTextColor="@color/primary"
        app:tabTextColor="@color/on_background" />

    <!-- Filtros del buscador: tipo de archivo y, según el tipo, formato (ver TelegramAccountActivity.updateSearchFilters) -->
    <LinearLayout
        android:id="@+id/tgSearchFilters"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface_dark"
        android:orientation="vertical"
        android:paddingBottom="6dp"
        android:visibility="gone">

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/tgTypeChips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="10dp"
                android:paddingTop="6dp" />
        </HorizontalScrollView>

        <HorizontalScrollView
            android:id="@+id/tgFormatScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/tgFormatChips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="10dp"
                android:paddingTop="6dp" />
        </HorizontalScrollView>
    </LinearLayout>

    <!-- Fila de filtros de la biblioteca/galería/buscador: tipo, novedades y géneros en botones (ver TelegramAccountActivity.updateFilterRow) -->
    <HorizontalScrollView
        android:id="@+id/tgGenreScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface_dark"
        android:scrollbars="none"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/tgGenreChips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp" />
    </HorizontalScrollView>

    <!-- Segunda fila: épocas (Halloween, Navidad…) y géneros -->
    <HorizontalScrollView
        android:id="@+id/tgThemeScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface_dark"
        android:scrollbars="none"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/tgThemeChips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp"
            android:paddingBottom="6dp" />
    </HorizontalScrollView>

    <!-- Aviso de directo en el chat (como en Telegram): toca para unirte -->
    <TextView
        android:id="@+id/tgLiveBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_tg_live_banner"
        android:nextFocusDown="@+id/recyclerView"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:padding="16dp"
        android:text="@string/tgacc_live_join"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:padding="6dp" />

        <TextView
            android:id="@+id/emptyView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:padding="32dp"
            android:gravity="center"
            android:textColor="@color/on_surface_muted"
            android:visibility="gone" />

        <!-- Ir al último mensaje (chat) o al más reciente (galería) -->
        <TextView
            android:id="@+id/tgToLast"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="bottom|end"
            android:layout_margin="14dp"
            android:background="@drawable/bg_fab_round"
            android:focusable="true"
            android:clickable="true"
            android:gravity="center"
            android:text="⬇"
            android:textColor="#FFFFFFFF"
            android:textSize="20sp"
            android:contentDescription="@string/tg_to_last"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Solo en Telegram con cuenta, dentro de un chat (ver TelegramAccountActivity) -->
    <LinearLayout
        android:id="@+id/inputBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="6dp"
        android:background="@color/surface_dark"
        android:visibility="gone">

        <!-- Teclado de respuesta del bot (botones que escriben un texto) -->
        <ScrollView
            android:id="@+id/tgKeyboardScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/tgKeyboard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>

        <TextView
            android:id="@+id/tgReplyLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="6dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/primary"
            android:textSize="13sp"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <Button
                android:id="@+id/tgAttach"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:text="📎" />

            <Button
                android:id="@+id/tgKbdToggle"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:text="⌨"
                android:visibility="gone" />

            <EditText
                android:id="@+id/tgInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/tgacc_write_hint"
                android:inputType="textMultiLine|textCapSentences"
                android:maxLines="4"
                android:textColor="@color/on_background"
                android:textColorHint="@color/on_surface_muted" />

            <Button
                android:id="@+id/tgCmds"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:layout_marginStart="2dp"
                android:text="/"
                android:textSize="20sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <Button
                android:id="@+id/tgSend"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="@string/tgacc_send" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
