<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingHorizontal="20dp"
    android:paddingVertical="10dp"
    android:background="@drawable/bg_list_item"
    android:clickable="true"
    android:focusable="true">

    <ImageView
        android:id="@+id/streamIcon"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@color/surface_dark"
        android:scaleType="centerInside"
        android:padding="6dp"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="16dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/streamName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/on_background"
            android:textSize="15sp" />

        <!-- EPG: "ahora" / "después" / "esta noche" (solo si la lista trae
             guía y el canal tiene tvg-id con coincidencia); cada línea
             oculta por separado si no hay dato para ese hueco. -->
        <TextView
            android:id="@+id/streamNowPlaying"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/on_surface_muted"
            android:textSize="12sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:visibility="gone" />

        <TextView
            android:id="@+id/streamNextPlaying"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/on_surface_muted"
            android:textSize="12sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:visibility="gone" />

        <TextView
            android:id="@+id/streamTonightPlaying"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/on_surface_muted"
            android:textSize="12sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:visibility="gone" />

    </LinearLayout>

    <ImageView
        android:id="@+id/favoriteIcon"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:padding="2dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="@string/action_favorites" />

</LinearLayout>
